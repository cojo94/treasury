@page "/budgets"
@rendermode InteractiveServer
@using Treasury.Application.Budgets
@using Treasury.Domain.Entities

<PageTitle>Budgets</PageTitle>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Budgets</h1>
            <p class="text-muted mb-0">Manage your budgets and track your progress.</p>
        </div>
        <button class="btn btn-primary">
            <i class="bi bi-plus-circle me-2"></i>Add Budget
        </button>
    </div>
    @if (budgets.Count == 0)
    {

        <div class="alert alert-info" role="alert">
            No budgets found. Please add a budget to get started.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var budget in budgets)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">@budget.StartDate.ToString("MMMM yyyy")</h5>
                            <p class="card-text">Budget Period: @budget.StartDate.ToString("MMMM dd") -
                                @budget.EndDate.ToString("MMMM dd")</p>
                                <p class="card-text">Income: @budgetSummaries[budget.Id].ActualIncome / @budget.PlannedIncome</p>
                                <p class="card-text">Expenses: @budgetSummaries[budget.Id].ActualExpenses / @budget.PlannedExpenses</p>
                                <p class="card-text">Net Difference: @budgetSummaries[budget.Id].NetDifference</p>
                                <p class="card-text">Savings Goal: @budget.SavingsGoal</p>
                                <button class="btn btn-primary">View Budget</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

@code {
    [Inject]
    public IBudgetService BudgetService { get; set; } = default!;
    private List<Budget> budgets = [];

    private Dictionary<Guid, BudgetSummary> budgetSummaries = new Dictionary<Guid, BudgetSummary>();

    protected override async Task OnInitializedAsync()
    {
        List<Budget> loadedBudgets = (await BudgetService.GetBudgetsAsync()).ToList();
        foreach (var budget in loadedBudgets)
        {
            var summary = await BudgetService.GetBudgetSummaryAsync(budget.Id);
            budgetSummaries[budget.Id] = summary;
        }
        budgets = loadedBudgets;
    }
}