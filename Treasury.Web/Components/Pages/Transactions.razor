@page "/transactions"
@rendermode InteractiveServer
@using Treasury.Application.Transactions
@using Treasury.Domain.Entities

<PageTitle>Transactions</PageTitle>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Transactions</h1>
            <p class="text-muted mb-0">Review, add, edit, and remove transactions in one place.</p>
        </div>
        <button class="btn btn-primary" @onclick="StartNewTransaction">
            <i class="bi bi-plus-circle me-2"></i>Add Transaction
        </button>
    </div>

    <div class="row justify-content-center mb-4">
        <div class="col-lg-8">
            <TransactionOverviewCard Transactions="transactions" />
        </div>
    </div>

    <Modal Title="@(isEditing ? "Edit Transaction" : "New Transaction")" Visible="showForm" OnClose="ResetForm">
        <TransactionForm Model="formModel" IsEditing="isEditing" OnCancel="ResetForm" OnSave="SaveTransaction" />
    </Modal>

    <TransactionTable Transactions="SortedTransactions" OnEdit="EditTransaction" OnDelete="ConfirmDelete" />
</div>

<DeleteConfirmation Visible="showDeleteConfirmation" Title="Delete Transaction?"
                    Message="Are you sure you want to delete this transaction? This action cannot be undone." OnCancel="CancelDelete"
                    OnConfirm="DeleteTransaction" />

@code {
    [Inject]
    private ITransactionService TransactionService { get; set; } = default!;

    private List<Transaction> transactions = [];
    private List<Transaction> SortedTransactions => transactions
        .OrderByDescending(t => t.Date)
        .ToList();

    private Transaction formModel = CreateTransaction();
    private Transaction? editingTransaction;
    private Transaction? transactionPendingDeletion;
    private bool isEditing;
    private bool showForm;
    private bool showDeleteConfirmation;

    protected override async Task OnInitializedAsync()
    {
        await RefreshTransactionsAsync();
    }

    private void StartNewTransaction()
    {
        formModel = CreateTransaction();
        editingTransaction = null;
        isEditing = false;
        showForm = true;
    }

    private void EditTransaction(Transaction transaction)
    {
        editingTransaction = transaction;
        formModel = new Transaction
        {
            Date = transaction.Date,
            Description = transaction.Description,
            Amount = transaction.Amount,
            Category = transaction.Category
        };
        isEditing = true;
        showForm = true;
    }

    private async Task SaveTransaction()
    {
        if (string.IsNullOrWhiteSpace(formModel.Description))
        {
            return;
        }
        formModel.Date = DateTime.SpecifyKind(
            formModel.Date,
            DateTimeKind.Utc);

        if (isEditing && editingTransaction is not null)
        {
            editingTransaction.Date = formModel.Date;
            editingTransaction.Description = formModel.Description;
            editingTransaction.Amount = formModel.Amount;
            editingTransaction.Category = formModel.Category;
            await TransactionService.UpdateTransactionAsync(editingTransaction);
            await RefreshTransactionsAsync();
        }
        else
        {
            var newTransaction = new Transaction
            {
                Date = formModel.Date,
                Description = formModel.Description,
                Amount = formModel.Amount,
                Category = formModel.Category
            };

            

            await TransactionService.AddTransactionAsync(newTransaction);
            await RefreshTransactionsAsync();
        }

        ResetForm();
    }

    private void ConfirmDelete(Transaction transaction)
    {
        transactionPendingDeletion = transaction;
        showDeleteConfirmation = true;
    }

    private async Task DeleteTransaction()
    {
        if (transactionPendingDeletion is null)
        {
            return;
        }

        await TransactionService.DeleteTransactionAsync(transactionPendingDeletion);
        await RefreshTransactionsAsync();

        if (editingTransaction == transactionPendingDeletion)
        {
            ResetForm();
        }

        CancelDelete();
    }

    private void CancelDelete()
    {
        transactionPendingDeletion = null;
        showDeleteConfirmation = false;
    }

    private void ResetForm()
    {
        formModel = CreateTransaction();
        editingTransaction = null;
        isEditing = false;
        showForm = false;
    }

    private async Task RefreshTransactionsAsync()
    {
        transactions = (await TransactionService.GetTransactionsAsync()).ToList();
    }

    private static Transaction CreateTransaction() => new()
    {
        Date = DateTime.UtcNow,
        Description = string.Empty,
        Amount = 0m,
        Category = "Other"
    };
}
