<div class="card shadow-sm border-0 rounded-0">
    <div class="card-body p-4">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Start Date</label>
                <input type="date" class="form-control" @bind="Model.StartDate" />
            </div>
            <div class="col-md-6">
                <label class="form-label">End Date</label>
                <input type="date" class="form-control" @bind="Model.EndDate" />
                @if (!string.IsNullOrEmpty(dateValidationError))
                {
                    <div class="text-danger mt-1">@dateValidationError</div>
                }

            </div>
            <div class="col-md-6">
                <label class="form-label">Planned Income</label>
                <input type="number" step="0.01" class="form-control" placeholder="30 000 SEK"
                       @bind="Model.PlannedIncome" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Planned Expenses</label>
                <input type="number" step="0.01" class="form-control" placeholder="20 000 SEK"
                       @bind="Model.PlannedExpenses" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Savings Goal</label>
                <input type="number" step="0.01" class="form-control" placeholder="10 000 SEK"
                       @bind="Model.SavingsGoal" />
            </div>
        </div>

        <div class="mt-4 d-flex gap-2">
            <button class="btn btn-primary" @onclick="HandleSaveAsync">Save</button>
            <button class="btn btn-outline-secondary" @onclick="OnCancel">Cancel</button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public required Budget Model { get; set; }

    [Parameter]
    public bool IsEditing { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Parameter]
    public EventCallback OnSave { get; set; }

    private string? dateValidationError;

    private async Task HandleSaveAsync()
    {
        if (Model.StartDate > Model.EndDate)
        {
            dateValidationError = "Budget start date must be on or before the end date";
            return;
        }

        dateValidationError = null;
        await OnSave.InvokeAsync();
    }
}