<Modal Title="@Title" Visible="Visible" OnClose="OnCancel">
    <div class="p-4">
        <p class="text-muted mb-4">
            @Message
        </p>

        <div class="d-flex justify-content-end gap-2">
            <button class="btn btn-outline-secondary btn-sm" @onclick="OnCancel">
                Cancel
            </button>
            <button class="btn btn-danger btn-sm" @onclick="OnConfirm">
                @ConfirmText
            </button>
        </div>
    </div>
</Modal>

@code {
    [Parameter]
    public bool Visible { get; set; }
    [Parameter]
    public string Title { get; set; } = "Confirm Deletion";
    [Parameter]
    public string Message { get; set; } = "Are you sure? This action cannot be undone.";
    [Parameter]
    public string ConfirmText { get; set; } = "Yes, delete";

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Parameter]
    public EventCallback OnConfirm { get; set; }
}